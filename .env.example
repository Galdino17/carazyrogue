# =============================================================================
# CarazyRogue — Configuração do ambiente local
# =============================================================================
# Copie este arquivo para .env.local e ajuste os valores conforme necessário.
# Variáveis já definidas no ambiente do sistema têm precedência sobre este arquivo.
#
# Valide a configuração com: node scripts/check-env.mjs
# =============================================================================

# Servidor local
HOST=127.0.0.1
PORT=5173

# Base path da build publicada. Mantenha /carazyrogue/ a menos que o caminho de deploy mude.
CARAZYROGUE_PUBLIC_BASE=/carazyrogue/

# Origem da API de produção embarcada na build publicada.
# Se diferente do padrão, serve-local.mjs reescreve o bundle automaticamente.
# DEVE ser um URL completo com schema (https://...).
CARAZYROGUE_API_ORIGIN=https://crazyrogue.duckdns.org

# Origem do Socket.IO. Se não definido, usa CARAZYROGUE_API_ORIGIN.
CARAZYROGUE_SOCKET_ORIGIN=https://crazyrogue.duckdns.org

# Mapas locais padrão.
# A build atual tem tilesets ausentes em: tutorial, mainMap, fightMap, map3, map4, mapIni.
# Use apenas mapas seguros: NewMapIni, desert, arena, room1.
CARAZYROGUE_LOCAL_FIRST_MAP=NewMapIni
CARAZYROGUE_LOCAL_HUB_MAP=NewMapIni

# Mock de Socket.IO local (1=ativo, 0=desativado — usa socket real em CARAZYROGUE_SOCKET_ORIGIN).
# Desative apenas se tiver acesso ao backend real e quiser testar eventos multiplayer.
CARAZYROGUE_LOCAL_SOCKET_MOCK=1
