# Local server
HOST=127.0.0.1
PORT=5173

# Published build base path. Keep this as /carazyrogue/ unless the deploy path changes.
CARAZYROGUE_PUBLIC_BASE=/carazyrogue/

# Real backend origin embedded in the published build.
CARAZYROGUE_API_ORIGIN=https://crazyrogue.duckdns.org
CARAZYROGUE_SOCKET_ORIGIN=https://crazyrogue.duckdns.org

# Local mock defaults. The current published build has broken tilesets on tutorial/mainMap/map3/map4/mapIni.
CARAZYROGUE_LOCAL_FIRST_MAP=NewMapIni
CARAZYROGUE_LOCAL_HUB_MAP=NewMapIni
CARAZYROGUE_LOCAL_SOCKET_MOCK=1
