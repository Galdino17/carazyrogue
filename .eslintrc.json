{
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-var": "error",
    "no-eval": "error",
    "no-debugger": "error",
    "prefer-const": "warn",
    "no-unused-vars": "warn",
    "eqeqeq": ["warn", "always"],
    "no-console": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "assets/*.js"
  ]
}
